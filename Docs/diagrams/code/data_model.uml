@startuml

' =====================================================
' TASK (definition only)
' =====================================================
class Task {
  +Id: string
  +Type: string
  +DependsOn: List<string>
  +Input: TaskInput
}

' =====================================================
' TASK INPUT (BASE)
' =====================================================
class TaskInput

class EmailInput {
  +Message: string
}

class AdditionInput {
  +A: int
  +B: int
}

TaskInput <|-- EmailInput
TaskInput <|-- AdditionInput

Task --> TaskInput

' =====================================================
' RESULT (BASE)
' =====================================================
class Result {
  +Success: bool
  +Error: string
  +Timestamp: DateTime
}

class AdditionResult {
  +Sum: int
}

class HttpResult {
  +Body: string
  +StatusCode: int
}

Result <|-- AdditionResult
Result <|-- HttpResult

' =====================================================
' WORKFLOW DEFINITION (STATIC STRUCTURE)
' =====================================================
class Workflow {
  +Id: string
  +Tasks: List<Task>
}

Workflow --> Task

' =====================================================
' TASK TYPES (OPTIONAL METADATA ONLY)
' =====================================================
class TaskType {
  +Name: string
}

Task --> TaskType

@enduml
